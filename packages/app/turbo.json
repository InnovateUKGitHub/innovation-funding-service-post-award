{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "esbuild": {
      "inputs": ["src/**", "esbuild.js", "tsconfig.json"],
      "outputs": ["dist/**"],
      "dependsOn": ["@innovateuk/common#build", "@innovateuk/logger#build", "@innovateuk/tsforce#build"]
    },
    "build": {
      "inputs": ["src/**", "webpack.config.js", "tsconfig.json"],
      "outputs": ["dist/**"],
      "dependsOn": ["@innovateuk/common#build", "@innovateuk/logger#build", "@innovateuk/tsforce#build"]
    },
    "test": {},
    "typecheck": {},
    "start": {
      "inputs": ["src/**", "webpack.config.js", "tsconfig.json"],
      "outputs": ["dist/**"],
      "dependsOn": ["@innovateuk/common#build", "@innovateuk/logger#build", "@innovateuk/tsforce#build"],
      "env": [
        "BUILD",
        "SALESFORCE_QUERY_LIMIT",
        "DISABLE_CSP",
        "COOKIE_KEY",
        "COOKIE_SECURE",
        "COST_CAT_TIMEOUT_MINUTES",
        "PROJ_ROLES_TIMEOUT_MINUTES",
        "RECORD_TYPES_TIMEOUT_MINUTES",
        "OPTIONS_LOOKUP_TIMEOUT_MINUTES",
        "TOKEN_TIMEOUT_MINUTES",
        "COOKIE_TIMEOUT_MINUTES",
        "CONTENT_REFRESH_TIMEOUT_SECONDS",
        "SALESFORCE_PRIVATE_KEY",
        "SALESFORCE_PRIVATE_KEY_FILE",
        "SHIBBOLETH_IDP_PUBLIC_KEY",
        "SHIBBOLETH_IDP_PUBLIC_KEY_FILE",
        "SHIBBOLETH_SP_SIGNING_PUBLIC_KEY",
        "SHIBBOLETH_SP_SIGNING_PUBLIC_KEY_FILE",
        "SHIBBOLETH_SP_SIGNING_PRIVATE_KEY",
        "SHIBBOLETH_SP_SIGNING_PRIVATE_KEY_FILE",
        "SHIBBOLETH_SP_DECRYPTION_PUBLIC_KEY",
        "SHIBBOLETH_SP_DECRYPTION_PUBLIC_KEY_FILE",
        "SHIBBOLETH_SP_DECRYPTION_PRIVATE_KEY",
        "SHIBBOLETH_SP_DECRYPTION_PRIVATE_KEY_FILE",
        "SIL_HYDRA_MTLS_CERTIFICATION_AUTHORITY",
        "SIL_HYDRA_MTLS_CERTIFICATION_AUTHORITY_FILE",
        "SIL_HYDRA_MTLS_PASSPHRASE",
        "SIL_HYDRA_MTLS_PUBLIC_KEY",
        "SIL_HYDRA_MTLS_PUBLIC_KEY_FILE",
        "SIL_HYDRA_MTLS_PRIVATE_KEY",
        "SIL_HYDRA_MTLS_PRIVATE_KEY_FILE",
        "SIL_HYDRA_MTLS_SERVER_NAME",
        "SIL_HYDRA_MTLS_REJECT_UNAUTHORISED",
        "BASIC_AUTH",
        "FEATURE_CHANGE_PERIOD_LENGTH",
        "FEATURE_CUSTOM_CONTENT",
        "SEARCH_DOCS_MIN_THRESHOLD",
        "FUTURE_TIME_EXTENSION_IN_YEARS",
        "FEATURE_APPROVE_NEW_SUBCONTRACTOR",
        "FEATURE_DETAILED_ERROR_SUMMARY_COMPONENT",
        "LOG_LEVEL",
        "BANK_CHECK_ADDRESS_SCORE_PASS",
        "BANK_CHECK_VALIDATION_RETRIES",
        "BANK_CHECK_COMPANY_NAME_SCORE_PASS",
        "PERMITTED_DOCUMENT_FILE_TYPES",
        "PERMITTED_WORD_PROCESSING_FILE_TYPES",
        "PERMITTED_PRESENTATION_FILE_TYPES",
        "PERMITTED_SPREADSHEET_FILE_TYPES",
        "PERMITTED_IMAGE_FILE_TYPES",
        "MAX_UPLOAD_FILE_COUNT",
        "MAX_FILE_SIZE_IN_BYTES",
        "MAX_TOTAL_FILE_SIZE_IN_BYTES",
        "MAX_FILE_BASENAME_LENGTH",
        "STANDARD_OVERHEAD_RATE",
        "FEATURE_SEARCH_NUMBER_PROJECTS",
        "FEATURE_MAX_CLAIM_LINE_ITEMS",
        "NON_JS_FEATURE_MAX_CLAIM_LINE_ITEMS",
        "SALESFORCE_CLIENT_ID",
        "SALESFORCE_CONNECTION_URL",
        "SALESFORCE_USERNAME",
        "SALESFORCE_CLIENT_ID",
        "SALESFORCE_CONNECTION_URL",
        "SALESFORCE_BANK_DETAILS_VALIDATION_USERNAME",
        "COMPANIES_HOUSE_ENDPOINT",
        "COMPANIES_HOUSE_ACCESS_TOKEN",
        "SIL_HYDRA_URL",
        "USE_SSO",
        "SSO_PROVIDER_URL",
        "SSO_SIGNOUT_URL",
        "IFS_ROOT",
        "IFS_APPLICATION_URL",
        "IFS_GRANT_LETTER_URL",
        "GOOGLE_TAG_MANAGER_CODE",
        "AWS_S3_ACCESS_KEY_ID",
        "AWS_S3_ACCESS_SECRET",
        "AWS_S3_CONTENT_BUCKET",
        "AWS_S3_CONTENT_CUSTOM_PATH",
        "ACC_ENVIRONMENT",
        "NEW_RELIC_ENABLED",
        "NEW_RELIC_EVENTS_URL",
        "NEW_RELIC_API_KEY",
        "NEW_RELIC_APP_NAME",
        "PORT",
        "SERVER_URL",
        "DEVELOPER_WRITE_GRAPHQL",
        "DEVELOPER_COLOURFUL_LOGGING",
        "DEVELOPER_OIDC",
        "DEVELOPER_OIDC_ISSUER",
        "DEVELOPER_OIDC_CLIENT_ID",
        "DEVELOPER_OIDC_CLIENT_SECRET",
        "DEVELOPER_DEFAULT_TO_SYSTEM_USER"
      ],
      "persistent": true,
      "cache": false
    }
  }
}
