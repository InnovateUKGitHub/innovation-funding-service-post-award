{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["src/**"],
      "outputs": ["dist/**"],
      "dependsOn": ["@innovateuk/common#typegen"]
    },
    "typegen": {
      "inputs": ["src/**"],
      "outputs": ["dist/**"]
    }
  }
}
