{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["^@innovateuk/project-factory-two#build"]
    },
    "build": {
      "inputs": ["src/**"],
      "outputs": ["dist/**"],
      "dependsOn": [
        "@innovateuk/project-factory-two#typegen",
        "@innovateuk/tsforce#build",
        "@innovateuk/common#build",
        "@innovateuk/logger#build"
      ]
    },
    "typegen": {
      "inputs": ["src/**"],
      "outputs": ["dist/**"],
      "dependsOn": ["@innovateuk/tsforce#typegen", "@innovateuk/common#typegen", "@innovateuk/logger#typegen"]
    }
  }
}
