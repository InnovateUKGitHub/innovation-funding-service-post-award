{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["^@innovateuk/project-factory#build"]
    },
    "build": {
      "inputs": ["src/**"],
      "outputs": ["dist/**"],
      "dependsOn": ["@innovateuk/logger#typegen"]
    },
    "typegen": {
      "inputs": ["src/**"],
      "outputs": ["dist/**"]
    }
  }
}
