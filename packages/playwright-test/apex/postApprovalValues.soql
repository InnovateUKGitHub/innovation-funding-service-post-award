SELECT Acc_ProjectPeriodNumber__c,
Owner.Name, 
Acc_ProjectParticipant__r.Name, 
Acc_ProjectParticipant__r.Acc_AccountId__r.Name,
Acc_ProjectParticipant__r.Acc_ProjectId__r.Acc_CompetitionId__r.Low_Risk_Claim_Counter__c,
Acc_ProjectParticipant__r.Acc_ProjectId__r.Acc_CompetitionId__r.Medium_Risk_Claim_Counter__c,
Acc_ProjectParticipant__r.Acc_ProjectId__r.Acc_CompetitionId__r.High_Risk_Claim_Counter__c,
Acc_ProjectParticipant__r.Acc_TotalParticipantCosts__c,
Acc_ProjectParticipant__r.Acc_Award_Rate__c,
Acc_ProjectParticipant__r.Acc_TotalParticipantGrant__c,
Acc_ProjectParticipant__r.Acc_TotalGrantApproved__c,
Acc_ProjectParticipant__r.Acc_RemainingParticipantGrant__c,
Acc_ProjectParticipant__r.Acc_TotalCostsSubmitted__c,
Acc_ProjectParticipant__r.Acc_TotalApprovedCosts__c,
Acc_ProjectParticipant__r.Acc_TotalCostsAwarded__c,
Acc_ProjectParticipant__r.Acc_DeferredGrant__c,
Acc_ProjectParticipant__r.Acc_CapLimitDeferredGrant__c,
Acc_ProjectParticipant__r.Acc_TotalPrepayment__c,
Acc_ProjectParticipant__r.Acc_TotalForecastsForParticipant__c,
Acc_ProjectParticipant__r.Acc_TotalFutureForecastsForParticipant__c,
Acc_Project__c, 
Acc_ProjectID__c, 
Acc_IAR_Status__c, 
Acc_Review_Team__c,
Acc_NumberofPeriods__c,
Acc_ProjectPeriodStartDate__c,
Acc_ProjectPeriodStartDateHelper__c,
Acc_ProjectPeriodEndDate__c,
Acc_ProjectPeriodEndDateHelper__c,
Acc_PeriodGrantToBePaidHelper__c,
Acc_IARRequired__c,
Acc_IAR_Required_Helper__c,
Acc_TotalParticipantCosts__c,
Acc_Total_Participant_Grant__c,
Acc_ThirdPartyPayment__c,
Acc_HubAndSpokeClaim__c,
Acc_CostsClaimedToDate__c,
Acc_Grant_Paid_To_Date__c,
Acc_TotalCostsSubmitted__c,
Acc_Prepayment__c,
Acc_DeferredGrantStaticDefGrant__c,
Acc_CapLimitPercentage__c,
Acc_StaticCapLimitDeferredGrant__c,
Acc_StaticAwardRate__c,
Acc_NewDefGrantPrepaymentCarriedForward__c,
Acc_DeferredGrantToBePaid__c,
Acc_OverrideGrantToBePaid__c,
Acc_ParticipantCapLimit__c,
Acc_NewCapLimitDeferredGrant__c,
Acc_TotalCostsApproved__c,
Acc_PeriodCostsApprovedForPayment__c,
Acc_Approved__c,
Acc_ApprovedDate__c,
QuickApproval__c,
Acc_StaticDeferredGrant__c,
Acc_PeriodApprovedDeferredGrant__c,
Acc_ClaimStatus__c,
Acc_ApprovalStatus__c,
Acc_PeriodCoststobePaid__c,
Acc_DeferredApprovalStatus__c,
Acc_FinalClaim__c
FROM Acc_Claims__c
WHERE Acc_ProjectParticipant__c = 'a0DPu0000064dfHMAQ'
AND RecordType.Name = 'Total Project Period'
ORDER BY Acc_ProjectPeriodNumber__c, Acc_ProjectParticipant__r.Name