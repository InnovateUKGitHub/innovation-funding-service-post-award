{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["@innovateuk/logger#build-client", "@innovateuk/logger#build-server", "@innovateuk/logger#typegen"]
    },
    "build-client": {
      "inputs": ["src/**"],
      "outputs": ["dist/**"],
      "dependsOn": ["@innovateuk/logger#typegen"]
    },
    "build-server": {
      "inputs": ["src/**"],
      "outputs": ["dist/**"],
      "dependsOn": ["@innovateuk/logger#typegen"]
    },
    "typegen": {
      "inputs": ["src/**"],
      "outputs": ["dist/**"]
    }
  }
}
