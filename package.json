{
  "name": "@innovateuk/acc-ui-monorepo",
  "private": true,
  "workspaces": [
    "./packages/app",
    "./packages/common",
    "./packages/environment-manager",
    "./packages/logger",
    "./packages/playwright-test",
    "./packages/project-factory-two",
    "./packages/tsforce",
    "./packages/update-schema"
  ],
  "scripts": {
    "build": "node turbo.mjs run build --",
    "test": "node turbo.mjs run test -- --passWithNoTests",
    "pw": "node turbo.mjs run pw --",
    "pw:dev": "TEST_SALESFORCE_SANDBOX=dev node turbo.mjs run pw --",
    "pw:bjssdev": "TEST_SALESFORCE_SANDBOX=bjssdev node turbo.mjs run pw --",
    "pw:accdev": "TEST_SALESFORCE_SANDBOX=accdev node turbo.mjs run pw --",
    "pw:at": "TEST_SALESFORCE_SANDBOX=at node turbo.mjs run pw --",
    "pw-run": "node turbo.mjs run pw-run --",
    "pw-run:dev": "TEST_SALESFORCE_SANDBOX=dev node turbo.mjs run pw-run --",
    "pw-run:bjssdev": "TEST_SALESFORCE_SANDBOX=bjssdev node turbo.mjs run pw-run --",
    "pw-run:accdev": "TEST_SALESFORCE_SANDBOX=accdev node turbo.mjs run pw-run --",
    "pw-run:at": "TEST_SALESFORCE_SANDBOX=at node turbo.mjs run pw-run --",
    "start": "node --env-file .env turbo.mjs run start --",
    "typegen": "node turbo.mjs run typegen --",
    "typecheck": "node turbo.mjs run typecheck --",
    "updateSchema": "node --env-file .env turbo.mjs run updateSchema --",
    "postinstall": "npm run patch-package",
    "patch-package": "patch-package",
    "clean": "npm exec --workspaces -c 'rm -rf dist'",
    "turbo": "node turbo.mjs"
  },
  "dependencies": {
    "turbo": "^2.2.4-canary.5",
    "patch-package": "^8.0.0"
  },
  "packageManager": "npm@10.5.2"
}
